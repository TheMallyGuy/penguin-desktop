{
  "name": "penguin-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "bake": "bun build src-tauri/src/typescript/script.ts --outdir src-tauri/src/baked_js --target=browser --format=iife",
    "bake:watch": "bun run scripts/bakeWatch.ts",
    "tauri": "tauri",
    "build:frontend": "bun run scripts/buildFrontend.ts",
    "build:frontend:serve": "bun run scripts/serveFrontendDev.ts --port 8601"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "~2",
    "@tauri-apps/plugin-notification": "~2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "~2",
    "@tauri-apps/plugin-process": "~2",
    "@tauri-apps/plugin-store": "~2",
    "@tauri-apps/plugin-updater": "~2",
    "tauri-plugin-drpc": "^1.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^6.0.3"
  },
  "patchedDependencies": {
    "tauri-plugin-drpc@1.0.3": "patches/tauri-plugin-drpc@1.0.3.patch"
  }
}
