{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "penguin-desktop",
  "version": "0.1.0",
  "identifier": "com.mally.penguinmod.desktop",
  "build": {
    "beforeDevCommand": "bun run scripts/dev.ts",
    "devUrl": "http://localhost:3000/editor.html",
    "beforeBuildCommand": "bun run bake && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "penguin-desktop",
        "width": 1459,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}